# ===== PackTruth 环境变量示例 =====
# 复制本文件为 .env，然后填入真实的 Key。
# .env 已被 .gitignore 排除，不会被提交。
# 绝对不要把真实 Key 写进源码、截图、日志或聊天窗口。

# --- 小米 MiMo（图片理解）---
# 控制台：https://platform.xiaomimimo.com/
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# 可选：mimo-v2.6-flash / mimo-v2.6-pro / mimo-v2.6-pro-ultraspeed
MIMO_VISION_MODEL=mimo-v2.6-flash

# --- DeepSeek（JSON 输出 / Search / Fetch）---
# 控制台：https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-flash

# --- 本地中转服务端口（仅 npm run server 时使用）---
PORT=8787
